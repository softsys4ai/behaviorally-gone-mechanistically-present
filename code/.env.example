# =============================================================================
# Credentials
# =============================================================================
HF_TOKEN=your_huggingface_token
OPENAI_API_KEY=your_openai_api_key    # required if using OpenAI judge (e.g. gpt-4o)
WANDB_API_KEY=your_wandb_api_key      # optional

# -----------------------------------------------------------------------------
# Google Gemini / Vertex AI Judge (optional alternative to OpenAI)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key                             # for Google AI Studio
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json   # for Vertex AI
GCP_PROJECT_ID=radiant-math-461518-q1                         # Vertex AI project ID
GCP_LOCATION=global                                           # Vertex AI location (global or us-central1)
GCP_ACCESS_TOKEN=                                             # optional GCP OAuth access token
JUDGE_MODEL=gpt-4o                                            # e.g. gpt-4o, gemini-3.7-flash, gemini-2.5-flash
JUDGE_PROVIDER=auto                                           # auto, openai, gemini, vertex

# =============================================================================
# Paths — edit for your environment
# =============================================================================
VENV=/path/to/venv/bin/python
DATA_ROOT=/path/to/output
INPUT_ROOT=/path/to/repo/code/input
HF_CACHE=/path/to/.cache/huggingface
HF_USERNAME=your_huggingface_username
SLURM_ACCOUNT=your_slurm_account
SLURM_EXCLUDE=                     # optional: comma-separated nodes to exclude
