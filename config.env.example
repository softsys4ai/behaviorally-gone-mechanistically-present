# Settings for the launchers (launch_pair.sh, code/scripts/run_*.sh, orchestrate_phase5.sh).
# Copy to config.env (untracked) and fill in. Only `export` lines are read.
# Variables set on the command line override the run settings below (e.g. TOPIC=cat SEED=43 bash launch_pair.sh).

# Credentials
export HF_TOKEN=""
export HF_USERNAME=""                          # adapters are pushed to <HF_USERNAME>/<model>-<topic>-gen<n>-s<seed>
export WANDB_API_KEY=""                        # optional
export GOOGLE_APPLICATION_CREDENTIALS=""       # service-account JSON for Vertex AI (Gemini judge)
export GCP_PROJECT_ID="your-gcp-project-id"
export GCP_LOCATION="global"

# Judge
export RUN_LLM_JUDGE=true
export JUDGE_PROVIDER="gemini"
export JUDGE_MODEL="gemini-3.7-flash"

# Paths
export HF_HOME="/path/to/hf_cache"
export DATA_ROOT="/path/to/experiments/subliminal"   # parent of the adam_lora/ and control/ run dirs

# Run
export MODEL="deepseek-ai/deepseek-llm-7b-chat"
export TOPIC="cat"
export SEED="42"
export RUN="adam_lora"
export NUM_GENERATIONS=10
export GPU=0
export GEN_BATCH=200
# export HF_RUN_TAG="exp2"                     # optional: added to Hub adapter names so runs don't collide
